# Copy to .env.local for local development, and add the same values
# in Vercel → Project → Settings → Environment Variables.
# These are server-only. Never prefix them with VITE_ (that would
# expose them in the browser bundle).

# Required: API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional: where form submissions are delivered.
CONTACT_TO_EMAIL=adityamittal4599@gmail.com

# Optional: the sender. Resend's test sender (below) only delivers to the
# email address your Resend account is registered with. To send from
# your own domain, verify it in Resend and use e.g.
# "Aditya Mittal <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
